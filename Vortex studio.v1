```html
<!DOCTYPE html>
<html lang="en" class="dark h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vortex Studio | Next-Gen AI Web Builder</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        cyber: {
                            bg: '#080911',
                            card: '#0f1122',
                            border: '#1f2442',
                            accent: '#00f0ff',
                            purple: '#7000ff',
                            pink: '#ff0055',
                            neonGreen: '#00ff66',
                            text: '#e2e8f0'
                        }
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        mono: ['Fira Code', 'monospace']
                    },
                    boxShadow: {
                        'neon-cyan': '0 0 15px rgba(0, 240, 255, 0.4)',
                        'neon-pink': '0 0 15px rgba(255, 0, 85, 0.4)',
                        'neon-purple': '0 0 15px rgba(112, 0, 255, 0.4)',
                        'cyber-glow': '0 0 30px rgba(0, 240, 255, 0.15)'
                    }
                }
            }
        }
    </script>
    <style>
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #080911;
        }
        ::-webkit-scrollbar-thumb {
            background: #1f2442;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #00f0ff;
        }
        
        .grid-bg {
            background-image: linear-gradient(to right, rgba(31, 36, 66, 0.3) 1px, transparent 1px),
                              linear-gradient(to bottom, rgba(31, 36, 66, 0.3) 1px, transparent 1px);
            background-size: 24px 24px;
        }

        .cyber-border-glow {
            position: relative;
        }
        .cyber-border-glow::after {
            content: '';
            position: absolute;
            inset: -1px;
            background: linear-gradient(45deg, #00f0ff, #7000ff, #ff0055);
            border-radius: inherit;
            z-index: -1;
            opacity: 0.3;
            transition: opacity 0.3s;
        }
        .cyber-border-glow:hover::after {
            opacity: 0.8;
        }

        @keyframes scanline {
            0% { transform: translateY(-100%); }
            100% { transform: translateY(1000%); }
        }
        .scanline {
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, rgba(0, 240, 255, 0.4), transparent);
            animation: scanline 8s linear infinite;
            pointer-events: none;
        }
    </style>
</head>
<body class="bg-cyber-bg text-cyber-text font-sans h-full flex flex-col overflow-hidden select-none">

    <!-- Top Navigation Header -->
    <header class="h-16 border-b border-cyber-border bg-cyber-card/90 backdrop-blur flex items-center justify-between px-4 z-40 shrink-0">
        <!-- Logo & Branding -->
        <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-cyber-purple via-cyber-accent to-cyber-pink p-[1px] shadow-neon-cyan">
                <div class="w-full h-full bg-cyber-bg rounded-[11px] flex items-center justify-center">
                    <i class="fa-solid font-bold text-cyber-accent fa-bolt text-xl animate-pulse"></i>
                </div>
            </div>
            <div>
                <div class="flex items-center space-x-2">
                    <span class="font-extrabold text-lg tracking-wider bg-gradient-to-r from-cyber-accent via-white to-cyber-pink bg-clip-text text-transparent">VORTEX</span>
                    <span class="px-1.5 py-0.5 text-[10px] uppercase font-mono font-bold bg-cyber-purple/30 text-cyber-accent border border-cyber-purple/50 rounded">v2.5</span>
                </div>
                <p class="text-[10px] text-gray-400 font-mono tracking-tight">AI HYPER-STUDIO</p>
            </div>
        </div>

        <!-- Viewport & Workspace Controls -->
        <div id="builder-controls" class="hidden md:flex items-center space-x-2 bg-cyber-bg/80 border border-cyber-border p-1 rounded-xl">
            <button id="view-desktop" onclick="setViewport('desktop')" class="px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-2 transition bg-cyber-accent/20 text-cyber-accent border border-cyber-accent/40 shadow-neon-cyan">
                <i class="fa-solid fa-desktop"></i>
                <span>Desktop</span>
            </button>
            <button id="view-tablet" onclick="setViewport('tablet')" class="px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-2 transition text-gray-400 hover:text-white hover:bg-cyber-card">
                <i class="fa-solid fa-tablet-screen-button"></i>
                <span>Tablet</span>
            </button>
            <button id="view-mobile" onclick="setViewport('mobile')" class="px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-2 transition text-gray-400 hover:text-white hover:bg-cyber-card">
                <i class="fa-solid fa-mobile-screen-button"></i>
                <span>Mobile</span>
            </button>
            <div class="h-4 w-[1px] bg-cyber-border mx-1"></div>
            <!-- Tab Switcher -->
            <button id="tab-canvas-btn" onclick="switchMode('canvas')" class="px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-2 transition text-white bg-cyber-purple/30 border border-cyber-purple/50">
                <i class="fa-solid fa-eye text-cyber-accent"></i>
                <span>Preview</span>
            </button>
            <button id="tab-code-btn" onclick="switchMode('code')" class="px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-2 transition text-gray-400 hover:text-white hover:bg-cyber-card">
                <i class="fa-solid fa-code text-cyber-pink"></i>
                <span>Source Code</span>
            </button>
        </div>

        <!-- User Profile & Action Tools -->
        <div class="flex items-center space-x-3">
            <button onclick="openExportModal()" class="hidden sm:flex items-center space-x-2 px-3 py-1.5 rounded-xl text-xs font-bold bg-gradient-to-r from-cyber-purple to-cyber-pink hover:opacity-90 transition shadow-neon-purple text-white">
                <i class="fa-solid fa-file-export"></i>
                <span>Export Site</span>
            </button>
            <button onclick="openDomainModal()" class="hidden sm:flex items-center space-x-2 px-3 py-1.5 rounded-xl text-xs font-semibold border border-cyber-border bg-cyber-card hover:border-cyber-accent transition text-gray-300">
                <i class="fa-solid fa-globe text-cyber-accent"></i>
                <span>Custom Domain</span>
            </button>

            <!-- User Auth Profile Widget -->
            <div id="auth-widget" class="relative">
                <!-- Guest View -->
                <div id="guest-controls" class="flex items-center space-x-2">
                    <button onclick="openAuthModal('login')" class="px-3 py-1.5 text-xs font-bold text-cyber-accent hover:underline">Log In</button>
                    <button onclick="openAuthModal('signup')" class="px-3 py-1.5 text-xs font-bold bg-cyber-accent text-cyber-bg rounded-lg hover:bg-cyan-300 transition shadow-neon-cyan">Sign Up</button>
                </div>
                <!-- Logged In View -->
                <div id="user-controls" class="hidden flex items-center space-x-2">
                    <div class="flex items-center space-x-2 px-2.5 py-1 rounded-xl bg-cyber-card border border-cyber-border cursor-pointer hover:border-cyber-accent/50 transition" onclick="toggleUserDropdown()">
                        <div id="user-avatar" class="w-7 h-7 rounded-lg bg-cyber-purple flex items-center justify-center font-bold text-xs text-white uppercase shadow-neon-purple">
                            VX
                        </div>
                        <span id="user-name-display" class="text-xs font-semibold text-gray-200 hidden sm:inline">Cyber Dev</span>
                        <i class="fa-solid fa-chevron-down text-[10px] text-gray-400"></i>
                    </div>
                    <!-- User Dropdown Menu -->
                    <div id="user-dropdown" class="hidden absolute right-0 top-12 w-48 bg-cyber-card border border-cyber-border rounded-xl shadow-2xl p-2 z-50">
                        <div class="px-3 py-2 border-b border-cyber-border">
                            <p id="dropdown-user-email" class="text-[11px] text-gray-400 truncate">dev@vortex.ai</p>
                            <span class="inline-block mt-1 px-1.5 py-0.5 text-[9px] bg-cyber-neonGreen/20 text-cyber-neonGreen rounded border border-cyber-neonGreen/40 font-mono">PRO PLAN ACTIVE</span>
                        </div>
                        <button onclick="openProfileModal()" class="w-full text-left px-3 py-2 text-xs text-gray-300 hover:bg-cyber-bg rounded-lg mt-1 flex items-center space-x-2">
                            <i class="fa-solid fa-id-card text-cyber-accent"></i>
                            <span>Profile Settings</span>
                        </button>
                        <button onclick="handleLogout()" class="w-full text-left px-3 py-2 text-xs text-cyber-pink hover:bg-cyber-bg rounded-lg flex items-center space-x-2">
                            <i class="fa-solid fa-right-from-bracket"></i>
                            <span>Sign Out</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Application Grid -->
    <div class="flex-1 flex overflow-hidden relative">
        <div class="scanline"></div>

        <!-- Left Sidebar: Multi-Agent AI Command Center -->
        <aside id="agent-sidebar" class="w-80 border-r border-cyber-border bg-cyber-card/60 backdrop-blur flex flex-col z-20 shrink-0">
            <!-- Sidebar Header -->
            <div class="p-3 border-b border-cyber-border flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <i class="fa-solid fa-brain text-cyber-accent"></i>
                    <h2 class="text-xs font-bold uppercase tracking-wider text-gray-200">AI Neural Crew</h2>
                </div>
                <span class="text-[10px] font-mono px-2 py-0.5 bg-cyber-accent/10 border border-cyber-accent/30 text-cyber-accent rounded-full">4 AGENTS ACTIVE</span>
            </div>

            <!-- Agent Selector Grid -->
            <div class="p-2 border-b border-cyber-border grid grid-cols-2 gap-1.5 bg-cyber-bg/40">
                <button onclick="selectAgent('architect')" id="agent-btn-architect" class="agent-btn p-2 rounded-xl border border-cyber-accent bg-cyber-accent/10 text-left transition flex items-start space-x-2">
                    <div class="w-6 h-6 rounded-lg bg-cyber-accent/20 flex items-center justify-center text-cyber-accent shrink-0 text-xs">
                        <i class="fa-solid fa-sitemap"></i>
                    </div>
                    <div class="overflow-hidden">
                        <p class="text-[11px] font-bold truncate text-white">Lead Architect</p>
                        <p class="text-[9px] text-gray-400 truncate">Structure & UX</p>
                    </div>
                </button>
                <button onclick="selectAgent('designer')" id="agent-btn-designer" class="agent-btn p-2 rounded-xl border border-cyber-border hover:border-cyber-pink/50 text-left transition flex items-start space-x-2">
                    <div class="w-6 h-6 rounded-lg bg-cyber-pink/20 flex items-center justify-center text-cyber-pink shrink-0 text-xs">
                        <i class="fa-solid fa-palette"></i>
                    </div>
                    <div class="overflow-hidden">
                        <p class="text-[11px] font-bold truncate text-white">UI Designer</p>
                        <p class="text-[9px] text-gray-400 truncate">Styles & Themes</p>
                    </div>
                </button>
                <button onclick="selectAgent('frontend')" id="agent-btn-frontend" class="agent-btn p-2 rounded-xl border border-cyber-border hover:border-cyber-purple/50 text-left transition flex items-start space-x-2">
                    <div class="w-6 h-6 rounded-lg bg-cyber-purple/20 flex items-center justify-center text-cyber-purple shrink-0 text-xs">
                        <i class="fa-solid fa-code"></i>
                    </div>
                    <div class="overflow-hidden">
                        <p class="text-[11px] font-bold truncate text-white">Frontend Dev</p>
                        <p class="text-[9px] text-gray-400 truncate">Components & Tailwind</p>
                    </div>
                </button>
                <button onclick="selectAgent('backend')" id="agent-btn-backend" class="agent-btn p-2 rounded-xl border border-cyber-border hover:border-cyber-neonGreen/50 text-left transition flex items-start space-x-2">
                    <div class="w-6 h-6 rounded-lg bg-cyber-neonGreen/20 flex items-center justify-center text-cyber-neonGreen shrink-0 text-xs">
                        <i class="fa-solid fa-server"></i>
                    </div>
                    <div class="overflow-hidden">
                        <p class="text-[11px] font-bold truncate text-white">Backend Arch</p>
                        <p class="text-[9px] text-gray-400 truncate">API & Logic</p>
                    </div>
                </button>
            </div>

            <!-- Agent Chat Feed -->
            <div id="chat-feed" class="flex-1 p-3 overflow-y-auto space-y-3 font-sans text-xs">
                <!-- Welcome Agent Message -->
                <div class="p-3 rounded-xl bg-cyber-bg/80 border border-cyber-border">
                    <div class="flex items-center justify-between mb-1.5">
                        <span class="text-[11px] font-bold text-cyber-accent flex items-center gap-1.5">
                            <i class="fa-solid fa-sitemap"></i> Lead Architect
                        </span>
                        <span class="text-[9px] font-mono text-gray-500">SYSTEM</span>
                    </div>
                    <p class="text-gray-300 leading-relaxed text-[11px]">
                        Welcome to Vortex Studio. What cybernetic web experience are we synthesizing today? Choose an agent or describe your layout concept below!
                    </p>
                </div>
            </div>

            <!-- Pre-made Cyber Prompt Chips -->
            <div class="p-2 border-t border-cyber-border flex items-center gap-1.5 overflow-x-auto text-[10px] bg-cyber-bg/50 scrollbar-none">
                <button onclick="applyQuickPrompt('SaaS Landing Page')" class="px-2 py-1 rounded-lg bg-cyber-card border border-cyber-border hover:border-cyber-accent text-gray-300 whitespace-nowrap transition">🚀 SaaS Cyber Hub</button>
                <button onclick="applyQuickPrompt('NFT Portfolio')" class="px-2 py-1 rounded-lg bg-cyber-card border border-cyber-border hover:border-cyber-pink text-gray-300 whitespace-nowrap transition">💎 Web3 Portfolio</button>
                <button onclick="applyQuickPrompt('AI Agency')" class="px-2 py-1 rounded-lg bg-cyber-card border border-cyber-border hover:border-cyber-purple text-gray-300 whitespace-nowrap transition">🤖 AI Agency</button>
            </div>

            <!-- Chat Prompt Input Area -->
            <div class="p-3 border-t border-cyber-border bg-cyber-card">
                <div class="relative">
                    <textarea id="ai-input" rows="2" placeholder="Prompt active agent (e.g., 'Generate a dark futuristic pricing table with neon hover effects')..." class="w-full bg-cyber-bg border border-cyber-border rounded-xl p-2.5 text-xs text-cyber-text placeholder-gray-500 focus:outline-none focus:border-cyber-accent resize-none pr-10"></textarea>
                    <button onclick="sendAgentMessage()" class="absolute right-2 bottom-3 p-1.5 rounded-lg bg-gradient-to-r from-cyber-accent to-cyber-purple text-cyber-bg font-bold hover:scale-105 transition shadow-neon-cyan">
                        <i class="fa-solid fa-paper-plane text-xs"></i>
                    </button>
                </div>
            </div>
        </aside>

        <!-- Center Interactive Studio Workspace -->
        <main class="flex-1 bg-cyber-bg grid-bg flex flex-col overflow-hidden relative">

            <!-- Workspace Status Bar -->
            <div class="h-9 border-b border-cyber-border bg-cyber-card/40 flex items-center justify-between px-4 text-xs font-mono text-gray-400">
                <div class="flex items-center space-x-3">
                    <span class="flex items-center space-x-1.5">
                        <span class="w-2 h-2 rounded-full bg-cyber-neonGreen animate-ping"></span>
                        <span class="text-gray-300 font-sans">LIVE ENVIRONMENT</span>
                    </span>
                    <span>|</span>
                    <span id="canvas-status">Render Engine: Active</span>
                </div>
                <div class="flex items-center space-x-3">
                    <button onclick="clearCanvas()" class="hover:text-cyber-pink transition text-[11px]"><i class="fa-solid fa-trash-can mr-1"></i> Clear</button>
                    <button onclick="refreshPreview()" class="hover:text-cyber-accent transition text-[11px]"><i class="fa-solid fa-rotate-right mr-1"></i> Reload</button>
                </div>
            </div>

            <!-- Mode 1: Live Interactive Canvas -->
            <div id="workspace-canvas-container" class="flex-1 flex justify-center items-center p-4 overflow-auto">
                <div id="viewport-frame" class="w-full h-full max-w-full bg-cyber-card border border-cyber-border rounded-2xl shadow-2xl transition-all duration-300 flex flex-col overflow-hidden relative">
                    <!-- Browser Bar Frame -->
                    <div class="h-8 bg-cyber-bg/90 border-b border-cyber-border flex items-center px-3 justify-between shrink-0">
                        <div class="flex items-center space-x-1.5">
                            <span class="w-2.5 h-2.5 rounded-full bg-red-500/80 inline-block"></span>
                            <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80 inline-block"></span>
                            <span class="w-2.5 h-2.5 rounded-full bg-green-500/80 inline-block"></span>
                        </div>
                        <div class="px-4 py-0.5 rounded-md bg-cyber-card border border-cyber-border text-[10px] font-mono text-gray-400 flex items-center space-x-2 w-1/2 justify-center">
                            <i class="fa-solid fa-lock text-[8px] text-cyber-neonGreen"></i>
                            <span class="truncate">https://vortex-studio.preview/site-v1</span>
                        </div>
                        <div class="text-[10px] font-mono text-cyber-accent" id="viewport-dim-label">100% WIDTH</div>
                    </div>
                    <!-- Live Dynamic Preview Iframe -->
                    <iframe id="preview-iframe" class="
